# Copie para ~/.maquina-4h/segredos.env (o instalador faz isso) e preencha SÓ o que for usar.
# NUNCA coloque este arquivo no GitHub. Cada pessoa usa as PRÓPRIAS contas e chaves.
# Tudo aqui é opcional: sem estas chaves a Agência funciona, só ficam de fora voz e WhatsApp.

# --- Voz (ElevenLabs) -- ferramentas/voz-elevenlabs.mjs ---
# Onde obter: elevenlabs.io > Developers > API Keys (crie uma chave restrita: Text to Speech + Voices Read).
ELEVENLABS_API_KEY=
# Onde obter: elevenlabs.io > Voices > a sua voz > "Copy Voice ID".
ELEVENLABS_VOICE_ID=
# Opcional: modelo de voz (deixe vazio para o padrão do script).
ELEVENLABS_MODEL=

# --- WhatsApp pelo app do Mac (ferramentas/whatsapp-enviar-auto.sh) ---
# Seu próprio número com DDI+DDD, só dígitos (ex.: o seu, no formato 55 + DDD + número).
WHATSAPP_PARA=

# --- WhatsApp Cloud API da Meta (ferramentas/whatsapp-enviar.mjs) -- avançado, opcional ---
# Onde obter: developers.facebook.com > seu app > WhatsApp > API Setup.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
